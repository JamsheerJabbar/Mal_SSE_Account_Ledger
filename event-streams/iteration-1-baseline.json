    "weekStartDate": "2026-01-01",
    "windowDays": 6,
    "capitalizationDay": 6,
    "dailyInterestRate": "0.0004",
    "storeRounding": "HALF_UP",
    "accrualRounding": "DOWN",
    "installmentRounding": "DOWN",
    "capitalizationExcludesOwnDay": true,
    "overdraftAssessmentExcludesOwnDayFee": true,
    "overdraftFeeOnDaysWithoutMovement": false,
    "discardAccrualRemainder": false,
    "maxRecomputePasses": 16,
    "overdraftFees": {
      "AED": "25.00",
      "BHD": "2.500"
    }
  },
  "accounts": [
